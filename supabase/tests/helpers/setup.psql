-- Helper condivisi dai test pgTAP. Si includono con `\ir helpers/setup.psql`
-- dopo `begin;`: tutto viene annullato dal rollback finale del test.

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

-- Crea un utente (il trigger crea il profilo) e lo registra con un nome breve.
create or replace function tests.create_user(p_name text, p_admin boolean default false)
returns uuid
language plpgsql
security definer
set search_path = public, pg_temp
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, email, raw_user_meta_data)
  values (v_id, p_name || '-' || v_id || '@test.local', jsonb_build_object('full_name', p_name));
  if p_admin then
    update public.profiles set role = 'admin' where id = v_id;
  end if;
  perform set_config('tests.user_' || p_name, v_id::text, true);
  return v_id;
end;
$$;

-- Crea un ospite (sessione anonima di Supabase): nessuna email, is_anonymous = true.
create or replace function tests.create_guest(p_name text)
returns uuid
language plpgsql
security definer
set search_path = public, pg_temp
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, is_anonymous) values (v_id, true);
  perform set_config('tests.user_' || p_name, v_id::text, true);
  perform set_config('tests.guest_' || p_name, 'true', true);
  return v_id;
end;
$$;

create or replace function tests.uid(p_name text)
returns uuid
language sql
stable
as $$ select current_setting('tests.user_' || p_name)::uuid $$;

-- Agisce come l'utente indicato: ruolo authenticated e claim come nel JWT di Supabase,
-- compreso is_anonymous (true per gli ospiti creati con create_guest; dopo una conversione
-- il test lo rimette a false con set_config('tests.guest_<nome>', 'false', true)).
-- Per tornare a postgres usare `reset role;`.
create or replace function tests.authenticate_as(p_name text)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object(
      'sub', tests.uid(p_name),
      'role', 'authenticated',
      'is_anonymous', coalesce(current_setting('tests.guest_' || p_name, true), '') = 'true'
    )::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create or replace function tests.as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end;
$$;
