# URL pubblico dell'app (usato per i redirect di auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (valori locali: `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile (CAPTCHA della sessione ospite e dell'invio del codice). Vuota in locale:
# si usa la site key di prova. In produzione obbligatoria, con la chiave segreta nella dashboard
# di Supabase (Authentication > Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cron di Vercel: Vercel lo manda come "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Voli (Travelpayouts, passo 2.1). Senza token la ricerca mostra lo stato vuoto con il link
# alla ricerca Aviasales. Solo lato server: mai con prefisso NEXT_PUBLIC_.
TRAVELPAYOUTS_TOKEN=
# Marker affiliato Travelpayouts, aggiunto ai link Aviasales. Vuoto: i link restano senza marker
# e l'admin lo segnala come "link non ancora affiliato".
TRAVELPAYOUTS_MARKER=
# Chiave HMAC dei link firmati di /api/go/flight (lunga e casuale, es. openssl rand -hex 32).
# Senza, le pagine non generano link di uscita e /api/go/flight risponde 400. Mai vuota in produzione.
FLIGHT_LINK_SECRET=

# Alloggi e noleggi (passo 3.1). Gli ID dei partner restano vuoti finché il programma è approvato:
# senza ID la pagina e i chip mostrano "in arrivo". Solo lato server, mai con NEXT_PUBLIC_.
# Il valore non esce mai nell'admin: lì si vede solo se la variabile è impostata.
BOOKING_AFFILIATE_ID=
DISCOVERCARS_AFFILIATE_ID=
GETYOURGUIDE_PARTNER_ID=
VIATOR_PARTNER_ID=
CIVITATIS_AGENCY_ID=
# Chiave HMAC dei link firmati di /api/go/v (alloggi e noleggi), lunga e casuale (openssl rand -hex 32).
# Senza, le pagine di alloggi e noleggi mostrano "in arrivo". Mai vuota in produzione.
AFFILIATE_LINK_SECRET=
# Chiave dei bucket del rate limit su /api/go (60 click al minuto per IP e per utente). Vuota: si usa
# AFFILIATE_LINK_SECRET. Senza nessuna delle due il limite non si applica. In produzione impostarla o tenere AFFILIATE_LINK_SECRET valorizzata.
RATE_LIMIT_SECRET=

# Email di invito ai gruppi (Resend). Vuote: l'invito via email è spento e la pagina del gruppo lo dice.
# EMAIL_FROM è il mittente verificato su Resend. Solo lato server, mai con NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=

# Solo cron e webhook. Mai importata da codice raggiungibile dal client.
SUPABASE_SECRET_KEY=

# Connessione diretta a Postgres per Drizzle e drizzle-kit
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Prepared statement di postgres.js: lasciare false con il pooler in modalità transaction
# (produzione su Vercel). true solo con connessione diretta o pooler in session mode.
DATABASE_PREPARED_STATEMENTS=false

# Google OAuth per Supabase locale (letti da supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Import del catalogo dei partner (passo 3.2, cron import-catalog). Vuote: il partner non gira.
# Solo lato server, mai con NEXT_PUBLIC_. Gli endpoint e i campi sono da verificare con la
# documentazione del partner prima di attivare l'import (docs/LANCIO.md).
VIATOR_API_KEY=
GETYOURGUIDE_API_KEY=
# Proposte di tag per le attività nuove (claude-haiku-5-5). Vuota: nessuna proposta, l'import resta.
ANTHROPIC_API_KEY=
# Provider degli embedding (cron embed-activities). Vuota = voyage, l'unico implementato.
EMBEDDINGS_PROVIDER=
# Chiave Voyage AI per gli embedding (modello voyage-3.5). Vuota: il cron non fa nulla.
VOYAGE_API_KEY=

# Chatbot (passo 9.1). ANTHROPIC_API_KEY (sopra) accende il chatbot; CHAT_ENABLED=false lo spegne.
# Solo test, ignorate su Vercel: CHAT_TEST_MODEL=scripted (risposte deterministiche con gli strumenti
# veri, per e2e e sviluppo senza chiave); CHAT_GUEST_DAILY_LIMIT abbassa il limite degli ospiti (max 10).
CHAT_ENABLED=
CHAT_TEST_MODEL=
CHAT_GUEST_DAILY_LIMIT=
