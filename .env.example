# URL pubblico dell'app (usato per i redirect di auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (valori locali: `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile (CAPTCHA della sessione ospite e dell'invio del codice). Vuota in locale:
# si usa la site key di prova. In produzione obbligatoria, con la chiave segreta nella dashboard
# di Supabase (Authentication > Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Chiave segreta di Turnstile per il modulo di contatto (verifica sul server, solo lato server).
# Fuori produzione, vuota: si usa la chiave di prova. In produzione obbligatoria, la stessa di SUPABASE_AUTH_CAPTCHA_SECRET.
TURNSTILE_SECRET_KEY=

# Dati del titolare per i testi legali e il contatto (docs/LANCIO.md, "Dati del titolare"). Tutte
# pubbliche, finché una manca le pagine legali restano in preparazione (noindex, fuori dalla sitemap).
# Partita IVA: 11 cifre. Le email devono essere valide: un valore malformato blocca il caricamento.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_VAT_NUMBER=
NEXT_PUBLIC_PRIVACY_EMAIL=
# Assistenza: indirizzo mostrato nel sito e destinatario dei messaggi del modulo di contatto.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Routing delle tratte stradali della mappa (OSRM, profilo auto). Il default è la demo pubblica di
# OSRM, solo per uso leggero: in produzione con traffico serve un servizio con licenza adeguata
# (OSRM self-hosted, Openrouteservice, GraphHopper), vedi docs/LANCIO.md, sezione 6b.
ROUTING_URL=https://router.project-osrm.org

# Cron di Vercel: Vercel lo manda come "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Indirizzo che riceve l'avviso quando un fornitore è in ritardo con il tracking (passo 7.3). Opzionale:
# senza, l'avviso resta solo nell'elenco admin. Solo lato server.
ORDERS_ADMIN_EMAIL=

# Voli (Travelpayouts, passo 2.1). Senza token la ricerca mostra lo stato vuoto con il link
# alla ricerca Aviasales. Solo lato server: mai con prefisso NEXT_PUBLIC_.
TRAVELPAYOUTS_TOKEN=
# Marker affiliato Travelpayouts, aggiunto ai link Aviasales. Vuoto: i link restano senza marker
# e l'admin lo segnala come "link non ancora affiliato".
TRAVELPAYOUTS_MARKER=
# Chiave HMAC dei link firmati di /api/go/flight (lunga e casuale, es. openssl rand -hex 32).
# Senza, le pagine non generano link di uscita e /api/go/flight risponde 400. Mai vuota in produzione.
FLIGHT_LINK_SECRET=

# Verticali affiliate (passi 3.1 e 3.2: alloggi, noleggi, traghetti, treni, transfer, biglietti, barche,
# assicurazione, eSIM, deposito bagagli). Gli ID dei partner restano vuoti finché il programma è approvato:
# senza ID il link funziona come link normale verso il partner (senza parametro d'affiliazione) e il
# click si registra comunque. Solo lato server, mai con NEXT_PUBLIC_.
# Il valore non esce mai nell'admin: lì si vede solo se la variabile è impostata.
BOOKING_AFFILIATE_ID=
DISCOVERCARS_AFFILIATE_ID=
GETYOURGUIDE_PARTNER_ID=
VIATOR_PARTNER_ID=
CIVITATIS_AGENCY_ID=
HOSTELWORLD_AFFILIATE_ID=
PITCHUP_AFFILIATE_ID=
RENTALCARS_AFFILIATE_ID=
FERRYHOPPER_AFFILIATE_ID=
DIRECTFERRIES_AFFILIATE_ID=
OMIO_AFFILIATE_ID=
WELCOMEPICKUPS_AFFILIATE_ID=
TIQETS_AFFILIATE_ID=
CLICKANDBOAT_AFFILIATE_ID=
SAMBOAT_AFFILIATE_ID=
HEYMONDO_AFFILIATE_ID=
AIRALO_AFFILIATE_ID=
RADICALSTORAGE_AFFILIATE_ID=
# Chiave HMAC dei link firmati di /api/go/v (alloggi e noleggi), lunga e casuale (openssl rand -hex 32).
# Senza, le pagine di alloggi e noleggi mostrano "in arrivo". Mai vuota in produzione.
AFFILIATE_LINK_SECRET=
# Chiave dei bucket del rate limit su /api/go (60 click al minuto per IP e per utente). Vuota: si usa
# AFFILIATE_LINK_SECRET. Senza nessuna delle due il limite non si applica. In produzione impostarla o tenere AFFILIATE_LINK_SECRET valorizzata.
RATE_LIMIT_SECRET=
# Obbligatoria in produzione: senza chiave i limiti di accesso, ospiti e aeroporti negano (fail closed) o non
# possono contare (vedi src/server/security/rate-limit.ts). Stessa regola di AFFILIATE_LINK_SECRET.

# Sentry (passo 11.5). Vuoti: nessun SDK parte e nessuna richiesta esce. NEXT_PUBLIC_SENTRY_DSN serve al browser;
# SENTRY_DSN solo al server, se diverso. Le sourcemap si caricano solo con SENTRY_AUTH_TOKEN (solo in CI/Vercel,
# mai nel browser): il token non ha mai il prefisso NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Email di invito ai gruppi (Resend). Vuote: l'invito via email è spento e la pagina del gruppo lo dice.
# EMAIL_FROM è il mittente verificato su Resend. Solo lato server, mai con NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=

# Solo cron e webhook. Mai importata da codice raggiungibile dal client.
SUPABASE_SECRET_KEY=

# Connessione diretta a Postgres per Drizzle e drizzle-kit
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Prepared statement di postgres.js: lasciare false con il pooler in modalità transaction
# (produzione su Vercel). true solo con connessione diretta o pooler in session mode.
DATABASE_PREPARED_STATEMENTS=false

# Google OAuth per Supabase locale (letti da supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Import del catalogo dei partner (passo 3.2, cron import-catalog). Vuote: il partner non gira.
# Solo lato server, mai con NEXT_PUBLIC_. Gli endpoint e i campi sono da verificare con la
# documentazione del partner prima di attivare l'import (docs/LANCIO.md).
VIATOR_API_KEY=
GETYOURGUIDE_API_KEY=
# Proposte di tag per le attività nuove (claude-haiku-5-5). Vuota: nessuna proposta, l'import resta.
ANTHROPIC_API_KEY=
# Provider degli embedding (cron embed-activities). Vuota = voyage, l'unico implementato.
EMBEDDINGS_PROVIDER=
# Chiave Voyage AI per gli embedding (modello voyage-3.5). Vuota: il cron non fa nulla.
VOYAGE_API_KEY=

# Chatbot (passo 9.1). ANTHROPIC_API_KEY (sopra) accende il chatbot; CHAT_ENABLED=false lo spegne.
# Solo test, ignorate su Vercel: CHAT_TEST_MODEL=scripted (risposte deterministiche con gli strumenti
# veri, per e2e e sviluppo senza chiave); CHAT_GUEST_DAILY_LIMIT abbassa il limite degli ospiti (max 10).
CHAT_ENABLED=
CHAT_TEST_MODEL=
CHAT_GUEST_DAILY_LIMIT=

# Pagamenti e carrello (passo 7.2). Solo lato server, mai con NEXT_PUBLIC_. Vuote: il carrello funziona,
# il pagamento resta in sospeso (docs/LANCIO.md, sezione 9b).
# Chiave segreta di Stripe: sk_test_... in sviluppo e nei test, sk_live_... solo in produzione.
STRIPE_SECRET_KEY=
# Accende Stripe Checkout (1) con la chiave sopra. Senza, il pagamento resta spento. Si imposta dal passo 7.3.
CHECKOUT_STRIPE_ENABLED=
# Segreto dell'endpoint del webhook (whsec_...). Senza, /api/stripe/webhook risponde 500.
STRIPE_WEBHOOK_SECRET=
# Chiave HMAC del cookie del carrello (lunga e casuale, es. openssl rand -hex 32). In produzione obbligatoria:
# senza, il carrello è spento. Fuori produzione, vuota: si usa una chiave di sviluppo.
CART_SECRET=
# Solo test, ignorata su Vercel (VERCEL_ENV presente): CHECKOUT_TEST_PROVIDER=fake usa il provider finto,
# con una pagina di prova al posto di Stripe e una scadenza simulata (e2e e sviluppo senza chiave).
CHECKOUT_TEST_PROVIDER=
