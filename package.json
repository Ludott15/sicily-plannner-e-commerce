{
  "name": "sicily-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:snapshot": "supabase db dump --local --schema public -f supabase/schema.sql",
    "db:drift": "bash scripts/check-schema-drift.sh",
    "test:int": "vitest run --project integration",
    "eval:chat": "vitest run --project eval",
    "design:tokens": "node scripts/design/generate-tokens.mjs",
    "design:brand": "node scripts/design/brand-assets.mjs",
    "design:check": "node scripts/design/generate-tokens.mjs --check && node scripts/design/brand-assets.mjs --check && node scripts/design/check-src.mjs",
    "email:templates": "node scripts/email/build-supabase-templates.mjs",
    "db:clean": "node scripts/db/clean-test-data.mjs",
    "supabase:push-production": "node scripts/supabase/push-production.mjs",
    "media:demo": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/media/demo-images.mjs",
    "predev": "node scripts/vendor/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/vendor/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.14.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.33.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
